# Multithreaded Python server : TCP Server Socket Thread Pool
class ClientThread(Thread):
    def __init__(self, ip, port, conn):
        Thread.__init__(self)
        self.ip = ip
        self.port = port
        self.conn = conn
        print ("[+] Nuevo server socket thread iniciado desde " + ip + ":" + str(port))
        #self.conn.send(str.encode('Bienvenido '+ ip + ' procesando comando...' + '\n'))    # lo quite por errores en el json


    def run(self):
        global TapasTimer
        global BuscadorTimer
        while True:
            data = self.conn.recv(2048).strip()
            if not data:
                print ("Comando Recibido: NO DATA")
                break
            #message_queues[self.conn].put(data)
            data = data.decode('utf-8') # decodificar el mensaje
            data = data.upper() # convertir a mayusculas
            print ("Comando Recibido: " + data)
            datasplit = data.split(' ')
            comando = datasplit[0]
            print (datasplit) #debug
            time.sleep(0.20)

            # Comandos
            # Abrir tapas del espejo primario y buscador.
            if comando == ':ABRIR;' or comando == 'OPENALL':        #EJEMPLO: echo :ABRIR; | nc 192.168.0.20 4545
                if TapasTimer:
                    TapasTimer.cancel()
                    TapasTimer = None
                if BuscadorTimer:
                    BuscadorTimer.cancel()
                    BuscadorTimer = None
                time.sleep(0.20)
                abreTapaNorte()
                try:
                    self.conn.send(str.encode('OK: ' + data + '\n'))  # echo
                except BrokenPipeError as e:
                    pass
                self.conn.close()
                time.sleep(5)
                abreTapaSur()
                time.sleep(0.20)
                abreBuscador()
                time.sleep(0.20)
                break


            # Cerrar tapas del espejo primario y buscador.
